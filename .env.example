# Tax Genius Pro - Environment Variables Template
# Copy this file to .env.local and fill in the values
# NEVER commit .env.local or any file with actual secrets

# ===========================================
# REQUIRED - Database
# ===========================================
DATABASE_URL=postgresql://user:password@host:port/database?schema=public

# ===========================================
# REQUIRED - Authentication (NextAuth.js)
# ===========================================
# Generate with: openssl rand -base64 32
AUTH_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://taxgeniuspro.tax

# ===========================================
# REQUIRED - Email (Resend)
# ===========================================
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@taxgeniuspro.tax

# ===========================================
# REQUIRED - Image Upload (Cloudinary)
# ===========================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ===========================================
# OPTIONAL - Payments (Square)
# ===========================================
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_ENVIRONMENT=sandbox

# ===========================================
# OPTIONAL - OAuth (Google)
# ===========================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===========================================
# OPTIONAL - AI Features
# ===========================================
GOOGLE_AI_API_KEY=

# ===========================================
# OPTIONAL - Push Notifications
# ===========================================
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ===========================================
# OPTIONAL - Analytics & Monitoring
# ===========================================
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ===========================================
# OPTIONAL - Redis (for rate limiting)
# ===========================================
REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ===========================================
# OPTIONAL - Cloud Storage (R2/S3)
# ===========================================
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ===========================================
# Application Settings
# ===========================================
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3005

# ===========================================
# Email Routing (optional overrides)
# ===========================================
EMAIL_ROUTING_EN_PRIMARY=
EMAIL_ROUTING_EN_CC=
EMAIL_ROUTING_ES_PRIMARY=
EMAIL_ROUTING_ES_CC=
EMAIL_ADMIN=
